<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Links - Login</title>
    <link rel="stylesheet" href="/style.css?v=<%= siteVersion %>">
</head>
<body>
    <div class="login-container">
        <div class="login-card builder"> 
            <h2 class="header-title" style="margin-top: 0; font-size: 1.5em; margin-bottom: 25px;">Admin Login</h2>
            
            <% if (error) { %> 
                <div style="color: #ed4245; font-size: 0.9em; margin-bottom: 15px;"><%= error %></div> 
            <% } %>
            
            <form action="/login" method="POST">
                <input type="text" name="username" placeholder="Username" required>
                <input type="password" name="password" placeholder="Password" required>
                <button type="submit" class="builder-btn" style="width: 100%;">Login</button>
            </form>
        </div>
    </div>
    <div class="credit-banner">
        Open source project from <a href="https://mcgrim.dev" target="_blank" rel="noopener">McGRiM</a>
    </div>
</body>
</body>
</html>