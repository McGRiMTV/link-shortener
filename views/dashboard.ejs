<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Links - Dashboard</title>
    <link rel="stylesheet" href="/style.css?v=<%= siteVersion %>">
</head>
<body>
    <header>
        <nav>
            <div class="header-left">
                <span class="header-title">Links Configuration</span>
            </div>
            <div class="header-right">
                <a href="/logout" class="builder-btn-red">Logout</a>
            </div>
        </nav>
    </header>

    <div class="container">
        
        <% if (error) { %>
            <div class="error-banner">⚠️ <%= error %></div>
        <% } %>

        <div class="builder">
            <h3 style="margin-top: 0; color: #fff;">Create New Link</h3>
            <form action="/shorten" method="POST" style="display: flex; flex-direction: column; gap: 15px;">
                <div class="input-group">
                    <div class="input-wrapper" style="flex: 2;">
                        <label>Destination URL</label>
                        <input type="url" name="long_url" placeholder="https://website.com/..." required>
                    </div>
                    <div class="input-wrapper" style="flex: 1;">
                        <label>Custom Name</label>
                        <input type="text" name="custom_name" placeholder="customname (no spaces)" pattern="[a-zA-Z0-9-_]+" required>
                    </div>
                </div>

                <div class="input-group" style="align-items: center;">
                    <div style="flex: 2; display: flex; gap: 15px; align-items: center;">
                        <div class="checkbox-wrapper" style="padding-bottom: 0;">
                            <input type="checkbox" name="is_protected" id="is_protected">
                            <label for="is_protected" style="text-transform: none; font-size: 0.95rem; white-space: nowrap;">Password Protect</label>
                        </div>
                        <div class="input-wrapper" id="password_wrapper" style="flex: 1; display: none;">
                            <input type="text" name="password" id="password_input" placeholder="Secret password">
                        </div>
                    </div>
                    <div style="flex: 1;">
                        <button type="submit" class="builder-btn" style="width: 100%;">Shorten</button>
                    </div>
                </div>
            </form>
        </div>

        <div class="preview">
            <h3 style="margin-top: 0; color: #fff;">Active Links</h3>
            <table>
                <thead>
                    <tr>
                        <th>Short Link</th>
                        <th>Destination</th>
                        <th>Status</th>
                        <th>Clicks</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    <% links.forEach(function(link) { %>
                        <tr>
                            <td><a class="link" href="https://<%= domain %>/<%= link.short_code %>" target="_blank"><%= domain %>/<%= link.short_code %></a></td>
                            <td style="max-width: 250px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;"><%= link.long_url %></td>
                            <td style="color: #b9bbbe; font-size: 13px;"><%- link.is_protected ? '🔒 Protected' : '🌐 Public' %></td>
                            <td style="color: #b9bbbe;"><%= link.clicks %></td>
                            <td style="text-align: right;">
                                <div style="display: flex; gap: 5px; justify-content: flex-end;">
                                    <button type="button" class="builder-btn" style="padding: 6px 12px; font-size: 12px; height: auto;" 
                                        data-id="<%= link.id %>" 
                                        data-url="<%= link.long_url %>" 
                                        data-protected="<%= link.is_protected %>" 
                                        data-pass="<%= link.password || '' %>" 
                                        onclick="openEditModal(this)">Edit</button>
                                    <form action="/delete/<%= link.id %>" method="POST" style="margin: 0;">
                                        <button type="submit" class="builder-btn-red" style="padding: 6px 12px; font-size: 12px; height: auto;" onclick="return confirm('Are you sure you want to delete this link?');">Delete</button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    <% }); %>
                </tbody>
            </table>
        </div>
    </div>
    
    <div id="editModal" class="modal">
        <div class="modal-content builder">
            <span class="close-btn" onclick="closeEditModal()">&times;</span>
            <h3 style="margin-top: 0; color: #fff; margin-bottom: 20px;">Edit Link</h3>
            <form id="editForm" method="POST" style="display: flex; flex-direction: column; gap: 15px;">
                <div class="input-wrapper">
                    <label>Destination URL</label>
                    <input type="url" name="long_url" id="edit_long_url" required>
                </div>
                <div class="checkbox-wrapper">
                    <input type="checkbox" name="is_protected" id="edit_is_protected">
                    <label for="edit_is_protected" style="text-transform: none; font-size: 0.95rem;">Password Protect</label>
                </div>
                <div class="input-wrapper" id="edit_password_wrapper" style="display: none; margin-bottom: 10px;">
                    <label>Password</label>
                    <input type="text" name="password" id="edit_password" placeholder="Enter secret password">
                </div>
                <button type="submit" class="builder-btn">Save Changes</button>
            </form>
        </div>
    </div>

    <div class="credit-banner">
        Open source project from <a href="https://mcgrim.dev" target="_blank" rel="noopener">McGRiM</a>
    </div>

    <script>
        document.getElementById('is_protected').addEventListener('change', function() {
            const wrapper = document.getElementById('password_wrapper');
            const input = document.getElementById('password_input');
            if (this.checked) {
                wrapper.style.display = 'flex';
                input.required = true;
            } else {
                wrapper.style.display = 'none';
                input.required = false;
            }
        });

        document.getElementById('edit_is_protected').addEventListener('change', function() {
            const wrapper = document.getElementById('edit_password_wrapper');
            const input = document.getElementById('edit_password');
            if (this.checked) {
                wrapper.style.display = 'flex';
                input.required = true;
            } else {
                wrapper.style.display = 'none';
                input.required = false;
            }
        });

        function openEditModal(btnElement) {
            const id = btnElement.getAttribute('data-id');
            const longUrl = btnElement.getAttribute('data-url');
            const isProtected = btnElement.getAttribute('data-protected') === 'true';
            const password = btnElement.getAttribute('data-pass');

            document.getElementById('editForm').action = '/edit/' + id;
            document.getElementById('edit_long_url').value = longUrl;
            document.getElementById('edit_is_protected').checked = isProtected;
            
            const passWrapper = document.getElementById('edit_password_wrapper');
            const passInput = document.getElementById('edit_password');

            if (isProtected) {
                passWrapper.style.display = 'flex';
                passInput.required = true;
                passInput.value = password;
            } else {
                passWrapper.style.display = 'none';
                passInput.required = false;
                passInput.value = '';
            }

            document.getElementById('editModal').style.display = 'flex';
        }

        function closeEditModal() {
            document.getElementById('editModal').style.display = 'none';
        }
    </script>
</body>
</html>